<?xml version='1.0' encoding='UTF-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code>; STR — Prototipo 3. Modelo didáctico, con datos ficticios.
; Un tick = un segundo simulado. No depende de la velocidad de animación.
breed [estaciones estacion]
breed [trenes tren]
breed [pasajeros pasajero]
breed [rotulos rotulo]

globals [
  nombres-linea posiciones-linea etiquetas-linea rutas-ida rutas-vuelta
  ingresados finalizados embarcados espera-acumulada secuencia-grupo
  cfg-estaciones cfg-trenes cfg-tramo cfg-parada cfg-maniobra
  cfg-capacidad cfg-intervalo cfg-semilla
]
estaciones-own [
  e-orden e-nombre e-acumulador e-proxima-salida e-ultima-salida
  e-salidas e-suma-intervalos e-cantidad-intervalos
]
trenes-own [
  t-id t-estado t-sentido t-actual t-objetivo t-restante t-capacidad
  t-listo-desde t-llegadas
]
pasajeros-own [
  p-personas p-origen p-destino p-sentido p-instante p-prioridad
  p-estado p-tren
]

; ---------- INICIALIZACIÓN ----------
to setup
  clear-all
  cargar-linea-d
  set cfg-estaciones length nombres-linea
  set cfg-trenes n-trenes
  set cfg-tramo viaje-seg
  set cfg-parada parada-seg
  set cfg-maniobra maniobra-seg
  set cfg-capacidad capacidad-tren
  set cfg-intervalo intervalo-seg
  set cfg-semilla semilla
  random-seed cfg-semilla
  ask patches [ set pcolor [247 249 247] ]
  foreach (range cfg-estaciones) [ indice-estacion -&gt;
    create-estaciones 1 [
      set e-orden indice-estacion
      set e-nombre item indice-estacion nombres-linea
      setxy (item 0 (item indice-estacion posiciones-linea)) (item 1 (item indice-estacion posiciones-linea))
      set shape "circle"
      set size 1.4
      set color green - 1
      set label ""
      set label-color black
      set e-proxima-salida cfg-parada
      set e-ultima-salida -1
    ]
  ]
  comprobar-geometria
  dibujar-linea
  foreach (range cfg-trenes) [ indice-tren -&gt;
    create-trenes 1 [
      set t-id indice-tren + 1
      set t-actual ifelse-value (indice-tren &lt; cfg-trenes / 2) [0] [cfg-estaciones - 1]
      set t-sentido ifelse-value (t-actual = 0) [1] [-1]
      set t-objetivo t-actual + t-sentido
      set t-estado "LISTO"
      set t-listo-desde 0
      set t-capacidad cfg-capacidad
      set shape "tren-str"
      set size 3.1
      set label-color black
      ubicar-en-terminal
    ]
  ]
  reset-ticks
  actualizar-vista
  comprobar-modelo
end

; ---------- ORDEN DE EVENTOS DEL SEGUNDO ----------
to go
  if not any? trenes [ stop ]
  tick-advance 1
  generar-pasajeros
  ; Orden fijo para no introducir prioridad aleatoria entre trenes.
  foreach sort-on [t-id] trenes [ formacion -&gt;
    ask formacion [ avanzar-tren ]
  ]
  ; Las dos terminales despachan sobre vías distintas.
  foreach (list 0 (cfg-estaciones - 1)) [ terminal-orden -&gt;
    ask one-of estaciones with [e-orden = terminal-orden] [ despachar-terminal ]
  ]
  actualizar-vista
  comprobar-modelo
  update-plots
end

; ---------- DEMANDA Y DESTINOS DE PRUEBA ----------
to generar-pasajeros
  foreach sort-on [e-orden] estaciones [ punto-ingreso -&gt;
    ask punto-ingreso [
      set e-acumulador e-acumulador + demanda-min / 60
      if ticks mod 10 = 0 [
        let pendientes floor (e-acumulador + 0.000000001)
        set e-acumulador max (list 0 (e-acumulador - pendientes))
        ; Sorteo separado del transporte: con igual semilla y demanda,
        ; los ingresos y destinos no cambian al modificar trenes o intervalo.
        with-local-randomness [
          random-seed ((cfg-semilla + ticks * 31 + e-orden * 104729) mod 2147483647)
          while [pendientes &gt; 0] [
            let cantidad-nueva min (list 5 pendientes)
            let origen-nuevo e-orden
            let destino-nuevo one-of (remove origen-nuevo (range cfg-estaciones))
            set secuencia-grupo secuencia-grupo + 1
            let prioridad-nueva secuencia-grupo
            hatch-pasajeros 1 [
              set p-personas cantidad-nueva
              set p-origen origen-nuevo
              set p-destino destino-nuevo
              set p-sentido ifelse-value (destino-nuevo &gt; origen-nuevo) [1] [-1]
              set p-instante ticks
              set p-prioridad prioridad-nueva
              set p-estado "ESPERANDO"
              set p-tren nobody
              set shape "circle"
              set size 0.55
              set label ""
              hide-turtle
            ]
            set ingresados ingresados + cantidad-nueva
            set pendientes pendientes - cantidad-nueva
          ]
        ]
      ]
    ]
  ]
end

; ---------- MOVIMIENTO, PARADAS Y RETORNO ----------
to avanzar-tren
  ifelse t-estado = "VIAJANDO" [
    set t-restante t-restante - 1
    ubicar-en-recorrido
    if t-restante = 0 [
      set t-actual t-objetivo
      set t-llegadas t-llegadas + 1
      descender-pasajeros
      ifelse member? t-actual (list 0 (cfg-estaciones - 1)) [
        ; Descenso total, maniobra y cambio a la vía de regreso.
        set t-sentido (- t-sentido)
        set t-objetivo t-actual + t-sentido
        set t-estado "MANIOBRA"
        set t-restante cfg-maniobra
        ubicar-en-terminal
      ] [
        set t-estado "DETENIDO"
        set t-restante cfg-parada
        embarcar-pasajeros
      ]
    ]
  ] [
    ifelse t-estado = "DETENIDO" [
      embarcar-pasajeros
      set t-restante max (list 0 (t-restante - 1))
      if t-restante = 0 [
        set t-objetivo t-actual + t-sentido
        if via-libre? [ iniciar-viaje ]
      ]
    ] [
      if t-estado = "MANIOBRA" [
        set t-restante t-restante - 1
        if t-restante = 0 [
          set t-estado "LISTO"
          set t-listo-desde ticks
        ]
      ]
    ]
  ]
end

to despachar-terminal
  if ticks &gt;= e-proxima-salida [
    let terminal-local e-orden
    let disponibles trenes with [t-actual = terminal-local and t-estado = "LISTO"]
    if any? disponibles [
      let ordenados sort-by [[uno dos] -&gt;
        ifelse-value ([t-listo-desde] of uno = [t-listo-desde] of dos)
          [[t-id] of uno &lt; [t-id] of dos]
          [[t-listo-desde] of uno &lt; [t-listo-desde] of dos]
      ] disponibles
      let elegido first ordenados
      if [via-libre?] of elegido [
        ask elegido [
          embarcar-pasajeros
          iniciar-viaje
        ]
        if e-ultima-salida &gt;= 0 [
          set e-suma-intervalos e-suma-intervalos + ticks - e-ultima-salida
          set e-cantidad-intervalos e-cantidad-intervalos + 1
        ]
        set e-ultima-salida ticks
        set e-salidas e-salidas + 1
        ; Tras una demora no se despachan trenes de golpe para recuperar horarios.
        set e-proxima-salida ticks + cfg-intervalo
      ]
    ]
  ]
end

to iniciar-viaje
  ; La salida siempre parte de la estación lógica actual, nunca del depósito.
  set t-estado "VIAJANDO"
  set t-restante cfg-tramo
  ubicar-en-recorrido
  show-turtle
end

; Bloqueo conservador: un tren por tramo y reserva del andén siguiente.
; No se aplica a los depósitos terminales, cuya maniobra es abstracta.
to-report via-libre?
  let direccion-local t-sentido
  let origen-local t-actual
  let destino-local t-objetivo
  report not any? other trenes with [
    t-sentido = direccion-local and
    ((t-estado = "VIAJANDO" and t-actual = origen-local) or
     (t-estado = "DETENIDO" and t-actual = destino-local))
  ]
end

to ubicar-en-terminal
  let punto-terminal one-of estaciones with [e-orden = [t-actual] of myself]
  move-to punto-terminal
  hide-turtle
end

to ubicar-en-recorrido
  let segmento-local min (list t-actual t-objetivo)
  let posicion-local posicion-ruta segmento-local t-sentido (1 - t-restante / cfg-tramo)
  setxy (item 0 posicion-local) (item 1 posicion-local)
  set heading item 2 posicion-local
end

to-report posicion-ruta [segmento-local direccion-local fraccion-local]
  let ruta-local item segmento-local (ifelse-value (direccion-local = 1) [rutas-ida] [rutas-vuelta])
  let distancia-local (max (list 0 (min (list 1 fraccion-local)))) * item 2 last ruta-local
  let nodo-local 0
  while [nodo-local &lt; length ruta-local - 2 and item 2 (item (nodo-local + 1) ruta-local) &lt; distancia-local] [
    set nodo-local nodo-local + 1
  ]
  let inicio-local item nodo-local ruta-local
  let fin-local item (nodo-local + 1) ruta-local
  let proporcion-local (distancia-local - item 2 inicio-local) / (item 2 fin-local - item 2 inicio-local)
  let dx-local item 0 fin-local - item 0 inicio-local
  let dy-local item 1 fin-local - item 1 inicio-local
  report (list
    (item 0 inicio-local + proporcion-local * dx-local)
    (item 1 inicio-local + proporcion-local * dy-local)
    (atan dx-local dy-local))
end

; ---------- DESCENSO, FIFO Y CAPACIDAD ----------
to descender-pasajeros
  let tren-local self
  let estacion-local t-actual
  ask pasajeros with [p-tren = tren-local and p-destino = estacion-local] [
    set finalizados finalizados + p-personas
    die
  ]
end

to embarcar-pasajeros
  let tren-local self
  let estacion-local t-actual
  let direccion-local t-sentido
  let libres t-capacidad - sum [p-personas] of pasajeros with [p-tren = tren-local]
  let cola sort-by [[uno dos] -&gt;
    ifelse-value ([p-instante] of uno = [p-instante] of dos)
      [[p-prioridad] of uno &lt; [p-prioridad] of dos]
      [[p-instante] of uno &lt; [p-instante] of dos]
  ] pasajeros with [p-estado = "ESPERANDO" and p-origen = estacion-local and p-sentido = direccion-local]
  foreach cola [ grupo-actual -&gt;
    if libres &gt; 0 [
      let cantidad-sube min (list libres [p-personas] of grupo-actual)
      set espera-acumulada espera-acumulada + cantidad-sube * (ticks - [p-instante] of grupo-actual)
      set embarcados embarcados + cantidad-sube
      ask grupo-actual [
        ifelse cantidad-sube = p-personas [
          set p-estado "VIAJANDO"
          set p-tren tren-local
          hide-turtle
        ] [
          set p-personas p-personas - cantidad-sube
          hatch-pasajeros 1 [
            set p-personas cantidad-sube
            set p-estado "VIAJANDO"
            set p-tren tren-local
            hide-turtle
          ]
        ]
      ]
      set libres libres - cantidad-sube
    ]
  ]
end

; ---------- REPRESENTACIÓN ----------
to actualizar-vista
  with-local-randomness [
    ask trenes [
      set color ifelse-value (t-estado = "VIAJANDO") [orange] [blue]
      set label (word "T" t-id)
      set label-color [35 48 44]
    ]
    ask estaciones [
      set color ifelse-value (e-orden = estacion-ver - 1) [yellow] [green - 1]
      set size ifelse-value (e-orden = estacion-ver - 1) [1.9] [1.15]
    ]
    ; Las colas se dibujan solo en la estación elegida para conservar legibilidad.
    ask pasajeros [hide-turtle]
    let elegida one-of estaciones with [e-orden = estacion-ver - 1]
    if elegida != nobody [
      let ox [xcor] of elegida
      let oy [ycor] of elegida
      foreach [-1 1] [ direccion-local -&gt;
        let cola sort-on [p-prioridad] pasajeros with [
          p-estado = "ESPERANDO" and p-origen = estacion-ver - 1 and p-sentido = direccion-local
        ]
        let indice-grupo 0
        foreach cola [ grupo-actual -&gt;
          ask grupo-actual [
            if indice-grupo &lt; 6 [
              show-turtle
              setxy (ox + 3 + indice-grupo mod 3) (oy + direccion-local * (3 + floor (indice-grupo / 3)))
              set color ifelse-value (direccion-local = 1) [violet] [red]
            ]
          ]
          set indice-grupo indice-grupo + 1
        ]
      ]
    ]
  ]
end

; Solo dibuja la geometría. No introduce trenes ni demanda.
to dibujar-linea
  create-turtles 1 [
    hide-turtle
    set pen-size 2.4
    set color [45 122 99]
    foreach (sentence rutas-ida rutas-vuelta) [ camino-local -&gt;
      pen-up
      setxy (item 0 first camino-local) (item 1 first camino-local)
      pen-down
      foreach but-first camino-local [ nodo-local -&gt;
        setxy (item 0 nodo-local) (item 1 nodo-local)
      ]
    ]
    pen-up
    set color [183 196 188]
    set pen-size 0.7
    foreach (range cfg-estaciones) [ indice-local -&gt;
      let centro-local item indice-local posiciones-linea
      let etiqueta-local item indice-local etiquetas-linea
      ; La guía termina junto al nombre, sin pasar por el texto.
      let extremo-x item 0 etiqueta-local
      let ancho-aproximado length (item indice-local nombres-linea) * 1.03 + 4
      if extremo-x &gt; item 0 centro-local [set extremo-x item 0 centro-local + 3]
      pen-up
      setxy (item 0 centro-local) (item 1 centro-local)
      pen-down
      setxy extremo-x (item 1 etiqueta-local)
    ]
    die
  ]
  foreach (range cfg-estaciones) [ indice-local -&gt;
    create-rotulos 1 [
      setxy (item 0 (item indice-local etiquetas-linea)) (item 1 (item indice-local etiquetas-linea))
      set size 0
      set label (word ifelse-value (indice-local &lt; 9) ["0"] [""] (indice-local + 1) "  " item indice-local nombres-linea)
      set label-color [35 48 44]
    ]
  ]
end

to-report nombre-seleccionado
  if not any? estaciones [ report "Pulsar Preparar" ]
  report [e-nombre] of one-of estaciones with [e-orden = estacion-ver - 1]
end

to-report cola-seleccionada [direccion-local]
  report sum [p-personas] of pasajeros with [p-estado = "ESPERANDO" and p-origen = estacion-ver - 1 and p-sentido = direccion-local]
end

to-report ocupacion-media
  if not any? trenes [report 0]
  let en-servicio trenes with [member? t-estado ["VIAJANDO" "DETENIDO"]]
  if not any? en-servicio [report 0]
  report 100 * a-bordo / (cfg-capacidad * count en-servicio)
end

; ---------- MÉTRICAS ----------
to-report esperando
  report sum [p-personas] of pasajeros with [p-estado = "ESPERANDO"]
end

to-report a-bordo
  report sum [p-personas] of pasajeros with [p-estado = "VIAJANDO"]
end

to-report espera-media
  if embarcados = 0 [ report 0 ]
  report espera-acumulada / embarcados
end

to-report espera-en-cola
  if esperando = 0 [ report 0 ]
  report sum [p-personas * (ticks - p-instante)] of pasajeros with [p-estado = "ESPERANDO"] / esperando
end

to-report balance
  report ingresados - esperando - a-bordo - finalizados
end

to-report intervalo-real [orden-terminal]
  let punto-terminal one-of estaciones with [e-orden = orden-terminal]
  if punto-terminal = nobody [ report 0 ]
  if [e-cantidad-intervalos] of punto-terminal = 0 [ report 0 ]
  report [e-suma-intervalos / e-cantidad-intervalos] of punto-terminal
end

to-report demora-terminal [orden-terminal]
  let punto-terminal one-of estaciones with [e-orden = orden-terminal]
  if punto-terminal = nobody [ report 0 ]
  report max (list 0 (ticks - [e-proxima-salida] of punto-terminal))
end

to-report ciclo-ideal
  if cfg-estaciones = 0 [ report 0 ]
  report 2 * ((cfg-estaciones - 1) * cfg-tramo + (cfg-estaciones - 2) * cfg-parada + cfg-maniobra)
end

to-report flota-orientativa
  if cfg-intervalo = 0 [ report 0 ]
  ; Redondeo a flota par por el reparto inicial entre terminales.
  report 2 * ceiling (ciclo-ideal / (2 * cfg-intervalo))
end

; ---------- VERIFICACIÓN AUTOMÁTICA ----------
to comprobar-modelo
  if balance != 0 [ error "No se conserva la cantidad de personas." ]
  if any? pasajeros with [p-personas &lt;= 0 or p-personas != floor p-personas] [
    error "Un grupo tiene una cantidad inválida."
  ]
  if any? pasajeros with [p-origen = p-destino or p-instante &gt; ticks] [
    error "Origen, destino o llegada inválidos."
  ]
  if any? pasajeros with [p-estado = "ESPERANDO" and p-tren != nobody] [
    error "Un grupo en espera tiene tren asignado."
  ]
  if any? pasajeros with [p-estado = "VIAJANDO" and p-tren = nobody] [
    error "Un grupo a bordo no tiene tren."
  ]
  if count trenes != cfg-trenes [ error "Se modificó la flota durante la ejecución." ]
  ask trenes [
    let tren-local self
    let estacion-local t-actual
    let destino-local t-objetivo
    let direccion-local t-sentido
    if sum [p-personas] of pasajeros with [p-tren = tren-local] &gt; t-capacidad [
      error "Un tren superó su capacidad."
    ]
    if member? t-estado ["LISTO" "MANIOBRA"] [
      if any? pasajeros with [p-tren = tren-local] [ error "Hay pasajeros en maniobra o depósito." ]
    ]
    if member? t-estado ["LISTO" "MANIOBRA"] [
      if not member? t-actual (list 0 (cfg-estaciones - 1)) [
        error "Una formación en depósito no está en una terminal."
      ]
      let x-terminal [xcor] of one-of estaciones with [e-orden = estacion-local]
      if abs (xcor - x-terminal) &gt; 0.000001 or not hidden? [
        error "Posición o visibilidad incorrecta en depósito terminal."
      ]
    ]
    if t-estado = "VIAJANDO" [
      let posicion-esperada posicion-ruta (min (list estacion-local destino-local)) direccion-local (1 - t-restante / cfg-tramo)
      if distancexy (item 0 posicion-esperada) (item 1 posicion-esperada) &gt; 0.00001 [
        error "La formación no sigue la geometría de su tramo."
      ]
      if hidden? [error "Un tren en servicio quedó oculto."]
      if t-restante &lt;= 0 [ error "Tiempo de viaje inválido." ]
      if any? other trenes with [t-estado = "VIAJANDO" and t-actual = estacion-local and t-sentido = direccion-local] [
        error "Dos trenes ocupan el mismo tramo y sentido."
      ]
      if any? other trenes with [t-estado = "DETENIDO" and t-actual = destino-local and t-sentido = direccion-local] [
        error "Un tren viaja hacia un andén ocupado."
      ]
    ]
    if t-estado = "DETENIDO" [
      if any? other trenes with [t-estado = "DETENIDO" and t-actual = estacion-local and t-sentido = direccion-local] [
        error "Dos trenes ocupan el mismo andén."
      ]
    ]
    if any? pasajeros with [p-tren = tren-local and p-sentido != direccion-local] [
      error "Pasajeros a bordo en sentido incorrecto."
    ]
  ]
end

; Fuente geométrica: SBASE / Buenos Aires Data, red_subte.geojson.
; CC-BY-2.5-AR. Geometría adaptada: proyección local, escala y vías desplazadas.
to cargar-linea-d
  set nombres-linea ["Catedral" "9 de Julio" "Tribunales – Teatro Colón" "Callao" "Facultad de Medicina" "Pueyrredón" "Agüero" "Bulnes" "Scalabrini Ortiz" "Plaza Italia" "Palermo" "Ministro Carranza" "Olleros" "José Hernández" "Juramento" "Congreso de Tucumán"]
  set posiciones-linea [[48.849753 -35.000000] [41.536830 -30.226296] [36.489560 -26.659182] [27.669237 -24.045499] [22.367241 -24.203255] [17.426494 -17.048484] [12.160492 -13.293710] [7.594331 -8.743300] [2.443746 -4.608341] [-3.346671 0.417157] [-8.335841 4.428659] [-18.613849 8.781654] [-29.281378 15.714547] [-37.521232 20.810241] [-42.342577 26.052353] [-48.849753 35.000000]]
  set etiquetas-linea [[66.180482 -35.000000] [37.536830 -30.226296] [70.174455 -26.659182] [23.669237 -24.045499] [52.289116 -21.203255] [13.426494 -17.048484] [28.118825 -13.293710] [3.594331 -8.743300] [26.532288 -4.608341] [-7.346671 0.417157] [8.573013 4.428659] [-22.613849 8.781654] [-13.502733 15.714547] [-41.521232 20.810241] [-23.160285 26.052353] [-17.828919 35.000000]]
