to comprobar-geometria
  if cfg-estaciones != 16 or length rutas-ida != 15 or length rutas-vuelta != 15 [
    error "La geometría no contiene las dieciséis estaciones de la línea D."
  ]
  foreach (range 14) [ indice-local -&gt;
    let final-ida last (item indice-local rutas-ida)
    let inicio-ida first (item (indice-local + 1) rutas-ida)
    let final-vuelta last (item (indice-local + 1) rutas-vuelta)
    let inicio-vuelta first (item indice-local rutas-vuelta)
    if abs (item 0 final-ida - item 0 inicio-ida) &gt; 0.00001 or
       abs (item 1 final-ida - item 1 inicio-ida) &gt; 0.00001 or
       abs (item 0 final-vuelta - item 0 inicio-vuelta) &gt; 0.00001 or
       abs (item 1 final-vuelta - item 1 inicio-vuelta) &gt; 0.00001 [
      error "Hay una discontinuidad entre dos tramos."
    ]
  ]
end

 ; DATOS: totales por estación durante 5 días en cada uno de los 3 tramos.
; Columnas: 07–11, 11–16, 16–20. Las duraciones acumuladas son 1200, 1500 y 1200 minutos.
to cargar-demanda-real
  set datos-ingreso [[8032 28532 45802] [4305 7343 6800] [5210 19782 17639] [7647 19685 19937] [9772 24677 23105] [7398 10501 9362] [10749 10945 11045] [13100 17515 16745] [12017 12746 14028] [8805 10996 14252] [14428 16663 18414] [14442 13839 13983] [13707 14181 15155] [15054 13980 15013] [17095 19496 22753] [46224 31441 32013]]
  let duraciones [1200 1500 1200]
  if tramo-dia &lt; 1 or tramo-dia &gt; 3 [error "Seleccione un tramo del 1 al 3."]
  if length datos-ingreso != 16 [error "Faltan datos de estaciones."]
  foreach datos-ingreso [ fila-datos -&gt;
    if length fila-datos != 3 [error "Faltan tramos de una estación."]
    if not empty? filter [valor-local -&gt; valor-local &lt; 0 or valor-local != floor valor-local] fila-datos [error "Ingresos inválidos."]
  ]
  set tasas-ingreso map [ fila-datos -&gt; item (tramo-dia - 1) fila-datos / item (tramo-dia - 1) duraciones ] datos-ingreso
end

to iniciar-medicion
  set base-ingresados ingresados
  set base-finalizados finalizados
  set embarcados 0
  set espera-acumulada 0
  set muestras-medicion 0
  set suma-colas 0
  set cola-maxima-muestreada 0
  set suma-ocupacion 0
  ask estaciones [ set e-ultima-salida -1 set e-suma-intervalos 0 set e-cantidad-intervalos 0 ]
end

; Una muestra cada diez segundos del estado de todo el sistema.
to muestrear-medicion
  let cola-ahora esperando
  set muestras-medicion muestras-medicion + 1
  set suma-colas suma-colas + cola-ahora
  set cola-maxima-muestreada max (list cola-maxima-muestreada cola-ahora)
  set suma-ocupacion suma-ocupacion + ocupacion-media
end

to-report cola-promedio-medicion
  if muestras-medicion = 0 [ report 0 ]
  report suma-colas / muestras-medicion
end

to-report ocupacion-promedio-medicion
  if muestras-medicion = 0 [ report 0 ]
  report suma-ocupacion / muestras-medicion
end

; Dos hipótesis: 1 equiprobable; 2 ponderación inversa a la distancia en estaciones.
; No hay distancias reales ni datos observados sobre destinos en molinetes.
to-report elegir-destino [origen-local]
  let candidatos remove origen-local (range cfg-estaciones)
  if cfg-destino = 1 [ report one-of candidatos ]
  let pesos map [ destino-local -&gt; 1 / abs (destino-local - origen-local) ] candidatos
  let numero-aleatorio random-float sum pesos
  let indice-local 0
  while [indice-local &lt; length candidatos - 1 and numero-aleatorio &gt;= item indice-local pesos] [
    set numero-aleatorio numero-aleatorio - item indice-local pesos
    set indice-local indice-local + 1
  ]
  report item indice-local candidatos
end

to-report tasa-en-foco
  if not is-list? tasas-ingreso [report 0]
  report item (estacion-foco - 1) tasas-ingreso * factor-demanda / 100
end

to-report tasa-total
  if not is-list? tasas-ingreso [report 0]
  report sum tasas-ingreso * factor-demanda / 100
end
