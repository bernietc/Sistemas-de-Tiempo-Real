<?xml version='1.0' encoding='UTF-8'?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code>; STR — Prototipo 3. Modelo didáctico, con datos ficticios.
; Un tick = un segundo simulado. No depende de la velocidad de animación.
breed [estaciones estacion]
breed [trenes tren]
breed [pasajeros pasajero]

globals [
  ingresados finalizados embarcados espera-acumulada secuencia-grupo
  cfg-estaciones cfg-trenes cfg-tramo cfg-parada cfg-maniobra
  cfg-capacidad cfg-intervalo cfg-semilla
]
estaciones-own [
  e-orden e-nombre e-acumulador e-proxima-salida e-ultima-salida
  e-salidas e-suma-intervalos e-cantidad-intervalos
]
trenes-own [
  t-id t-estado t-sentido t-actual t-objetivo t-restante t-capacidad
  t-listo-desde t-llegadas
]
pasajeros-own [
  p-personas p-origen p-destino p-sentido p-instante p-prioridad
  p-estado p-tren
]

; ---------- INICIALIZACIÓN ----------
to setup
  clear-all
  set cfg-estaciones n-estaciones
  set cfg-trenes n-trenes
  set cfg-tramo viaje-seg
  set cfg-parada parada-seg
  set cfg-maniobra maniobra-seg
  set cfg-capacidad capacidad-tren
  set cfg-intervalo intervalo-seg
  set cfg-semilla semilla
  random-seed cfg-semilla
  ask patches [ set pcolor 9.5 ]
  ; Dos vías esquemáticas. Los segmentos no usan la distancia del dibujo.
  ask patches with [abs pxcor &lt;= 42 and abs pycor = 3] [set pcolor gray]
  foreach (range cfg-estaciones) [ indice-estacion -&gt;
    create-estaciones 1 [
      set e-orden indice-estacion
      set e-nombre item indice-estacion ["A" "B" "C" "D" "E" "F" "G" "H" "I" "J"]
      setxy (-42 + 84 * indice-estacion / (cfg-estaciones - 1)) 0
      set shape "circle"
      set size 1.4
      set color green - 1
      set label e-nombre
      set label-color black
      set e-proxima-salida cfg-parada
      set e-ultima-salida -1
    ]
  ]
  foreach (range cfg-trenes) [ indice-tren -&gt;
    create-trenes 1 [
      set t-id indice-tren + 1
      set t-actual ifelse-value (indice-tren &lt; cfg-trenes / 2) [0] [cfg-estaciones - 1]
      set t-sentido ifelse-value (t-actual = 0) [1] [-1]
      set t-objetivo t-actual + t-sentido
      set t-estado "LISTO"
      set t-listo-desde 0
      set t-capacidad cfg-capacidad
      set shape "tren-str"
      set size 2.2
      set label-color black
      ubicar-en-terminal
    ]
  ]
  reset-ticks
  actualizar-vista
  comprobar-modelo
end

; ---------- ORDEN DE EVENTOS DEL SEGUNDO ----------
to go
  if not any? trenes [ stop ]
  tick-advance 1
  generar-pasajeros
  ; Orden fijo para no introducir prioridad aleatoria entre trenes.
  foreach sort-on [t-id] trenes [ formacion -&gt;
    ask formacion [ avanzar-tren ]
  ]
  ; Las dos terminales despachan sobre vías distintas.
  foreach (list 0 (cfg-estaciones - 1)) [ terminal-orden -&gt;
    ask one-of estaciones with [e-orden = terminal-orden] [ despachar-terminal ]
  ]
  actualizar-vista
  comprobar-modelo
  update-plots
end

; ---------- DEMANDA Y DESTINOS DE PRUEBA ----------
to generar-pasajeros
  foreach sort-on [e-orden] estaciones [ punto-ingreso -&gt;
    ask punto-ingreso [
      set e-acumulador e-acumulador + demanda-min / 60
      if ticks mod 10 = 0 [
        let pendientes floor (e-acumulador + 0.000000001)
        set e-acumulador max (list 0 (e-acumulador - pendientes))
        ; Sorteo separado del transporte: con igual semilla y demanda,
        ; los ingresos y destinos no cambian al modificar trenes o intervalo.
        with-local-randomness [
          random-seed ((cfg-semilla + ticks * 31 + e-orden * 104729) mod 2147483647)
          while [pendientes &gt; 0] [
            let cantidad-nueva min (list 5 pendientes)
            let origen-nuevo e-orden
            let destino-nuevo one-of (remove origen-nuevo (range cfg-estaciones))
            set secuencia-grupo secuencia-grupo + 1
            let prioridad-nueva secuencia-grupo
            hatch-pasajeros 1 [
              set p-personas cantidad-nueva
              set p-origen origen-nuevo
              set p-destino destino-nuevo
              set p-sentido ifelse-value (destino-nuevo &gt; origen-nuevo) [1] [-1]
              set p-instante ticks
              set p-prioridad prioridad-nueva
              set p-estado "ESPERANDO"
              set p-tren nobody
              set shape "circle"
              set size 0.55
              set label ""
              hide-turtle
            ]
            set ingresados ingresados + cantidad-nueva
            set pendientes pendientes - cantidad-nueva
          ]
        ]
      ]
    ]
  ]
end

; ---------- MOVIMIENTO, PARADAS Y RETORNO ----------
to avanzar-tren
  ifelse t-estado = "VIAJANDO" [
    let punto-destino one-of estaciones with [e-orden = [t-objetivo] of myself]
    set xcor xcor + (([xcor] of punto-destino - xcor) / t-restante)
    set t-restante t-restante - 1
    if t-restante = 0 [
      set t-actual t-objetivo
      set t-llegadas t-llegadas + 1
      descender-pasajeros
      ifelse member? t-actual (list 0 (cfg-estaciones - 1)) [
        ; Descenso total, maniobra y cambio a la vía de regreso.
        set t-sentido (- t-sentido)
        set t-objetivo t-actual + t-sentido
        set t-estado "MANIOBRA"
        set t-restante cfg-maniobra
        ubicar-en-terminal
      ] [
        set t-estado "DETENIDO"
        set t-restante cfg-parada
        embarcar-pasajeros
      ]
    ]
  ] [
    ifelse t-estado = "DETENIDO" [
      embarcar-pasajeros
      set t-restante max (list 0 (t-restante - 1))
      if t-restante = 0 [
        set t-objetivo t-actual + t-sentido
        if via-libre? [ iniciar-viaje ]
      ]
    ] [
      if t-estado = "MANIOBRA" [
        set t-restante t-restante - 1
        if t-restante = 0 [
          set t-estado "LISTO"
          set t-listo-desde ticks
        ]
      ]
    ]
  ]
end

to despachar-terminal
  if ticks &gt;= e-proxima-salida [
    let terminal-local e-orden
    let disponibles trenes with [t-actual = terminal-local and t-estado = "LISTO"]
    if any? disponibles [
      let ordenados sort-by [[uno dos] -&gt;
        ifelse-value ([t-listo-desde] of uno = [t-listo-desde] of dos)
          [[t-id] of uno &lt; [t-id] of dos]
          [[t-listo-desde] of uno &lt; [t-listo-desde] of dos]
      ] disponibles
      let elegido first ordenados
      if [via-libre?] of elegido [
        ask elegido [
          embarcar-pasajeros
          iniciar-viaje
        ]
        if e-ultima-salida &gt;= 0 [
          set e-suma-intervalos e-suma-intervalos + ticks - e-ultima-salida
          set e-cantidad-intervalos e-cantidad-intervalos + 1
        ]
        set e-ultima-salida ticks
        set e-salidas e-salidas + 1
        ; Tras una demora no se despachan trenes de golpe para recuperar horarios.
        set e-proxima-salida ticks + cfg-intervalo
      ]
    ]
  ]
end

to iniciar-viaje
  ; La salida siempre parte de la estación lógica actual, nunca del depósito.
  let punto-salida one-of estaciones with [e-orden = [t-actual] of myself]
  set xcor [xcor] of punto-salida
  show-turtle
  set t-estado "VIAJANDO"
  set t-restante cfg-tramo
  set heading ifelse-value (t-sentido = 1) [90] [270]
  set ycor ifelse-value (t-sentido = 1) [3] [-3]
end

; Bloqueo conservador: un tren por tramo y reserva del andén siguiente.
; No se aplica a los depósitos terminales, cuya maniobra es abstracta.
to-report via-libre?
  let direccion-local t-sentido
  let origen-local t-actual
  let destino-local t-objetivo
  report not any? other trenes with [
    t-sentido = direccion-local and
    ((t-estado = "VIAJANDO" and t-actual = origen-local) or
     (t-estado = "DETENIDO" and t-actual = destino-local))
  ]
end

to ubicar-en-terminal
  ; Depósito abstracto en la MISMA terminal. No se desplaza por el recorrido.
  let punto-terminal one-of estaciones with [e-orden = [t-actual] of myself]
  setxy [xcor] of punto-terminal (ifelse-value (t-actual = 0) [11] [-11])
  set heading ifelse-value (t-sentido = 1) [90] [270]
  ; Evita superponer las formaciones estacionadas sobre estaciones internas.
  ; Siguen existiendo y se cuentan en los monitores Listos / Maniobra.
  hide-turtle
end

; ---------- DESCENSO, FIFO Y CAPACIDAD ----------
to descender-pasajeros
  let tren-local self
  let estacion-local t-actual
  ask pasajeros with [p-tren = tren-local and p-destino = estacion-local] [
    set finalizados finalizados + p-personas
    die
  ]
end

to embarcar-pasajeros
  let tren-local self
  let estacion-local t-actual
  let direccion-local t-sentido
  let libres t-capacidad - sum [p-personas] of pasajeros with [p-tren = tren-local]
  let cola sort-by [[uno dos] -&gt;
    ifelse-value ([p-instante] of uno = [p-instante] of dos)
      [[p-prioridad] of uno &lt; [p-prioridad] of dos]
      [[p-instante] of uno &lt; [p-instante] of dos]
  ] pasajeros with [p-estado = "ESPERANDO" and p-origen = estacion-local and p-sentido = direccion-local]
  foreach cola [ grupo-actual -&gt;
    if libres &gt; 0 [
      let cantidad-sube min (list libres [p-personas] of grupo-actual)
      set espera-acumulada espera-acumulada + cantidad-sube * (ticks - [p-instante] of grupo-actual)
      set embarcados embarcados + cantidad-sube
      ask grupo-actual [
        ifelse cantidad-sube = p-personas [
          set p-estado "VIAJANDO"
          set p-tren tren-local
          hide-turtle
        ] [
          set p-personas p-personas - cantidad-sube
          hatch-pasajeros 1 [
            set p-personas cantidad-sube
            set p-estado "VIAJANDO"
            set p-tren tren-local
            hide-turtle
          ]
        ]
      ]
      set libres libres - cantidad-sube
    ]
  ]
end

; ---------- REPRESENTACIÓN ----------
to actualizar-vista
  ; La representación no altera los sorteos de demanda.
  with-local-randomness [
    ask trenes [
      let tren-local self
      let ocupacion-local sum [p-personas] of pasajeros with [p-tren = tren-local]
      set color ifelse-value (t-estado = "VIAJANDO") [orange]
        [ifelse-value (t-estado = "MANIOBRA") [gray] [blue]]
      set label ifelse-value (member? t-estado ["LISTO" "MANIOBRA"])
        [(word "T" t-id ifelse-value (t-estado = "LISTO") [" L"] [" M"])]
        [(word "T" t-id " " ocupacion-local "/" t-capacidad)]
    ]
    ask estaciones [
      let origen-local e-orden
      foreach [-1 1] [ direccion-local -&gt;
        let cola sort-on [p-prioridad] pasajeros with [
          p-estado = "ESPERANDO" and p-origen = origen-local and p-sentido = direccion-local
        ]
        let px-local xcor
        let py-local ifelse-value (direccion-local = 1) [5] [-5]
        let total-local sum [p-personas] of pasajeros with [
          p-estado = "ESPERANDO" and p-origen = origen-local and p-sentido = direccion-local
        ]
        ask patch px-local py-local [
          set plabel (word total-local " pers.")
          set plabel-color black
        ]
        let indice-grupo 0
        foreach cola [ grupo-actual -&gt;
          ask grupo-actual [
            ifelse indice-grupo &lt; 6 [
              show-turtle
              setxy (px-local - 1 + (indice-grupo mod 3))
                (py-local + direccion-local * (1.5 + floor (indice-grupo / 3)))
              set color ifelse-value (direccion-local = 1) [violet] [red]
            ] [ hide-turtle ]
          ]
          set indice-grupo indice-grupo + 1
        ]
      ]
    ]
  ]
end

; ---------- MÉTRICAS ----------
to-report esperando
  report sum [p-personas] of pasajeros with [p-estado = "ESPERANDO"]
end

to-report a-bordo
  report sum [p-personas] of pasajeros with [p-estado = "VIAJANDO"]
end

to-report espera-media
  if embarcados = 0 [ report 0 ]
  report espera-acumulada / embarcados
end

to-report espera-en-cola
  if esperando = 0 [ report 0 ]
  report sum [p-personas * (ticks - p-instante)] of pasajeros with [p-estado = "ESPERANDO"] / esperando
end

to-report balance
  report ingresados - esperando - a-bordo - finalizados
end

to-report intervalo-real [orden-terminal]
  let punto-terminal one-of estaciones with [e-orden = orden-terminal]
  if punto-terminal = nobody [ report 0 ]
  if [e-cantidad-intervalos] of punto-terminal = 0 [ report 0 ]
  report [e-suma-intervalos / e-cantidad-intervalos] of punto-terminal
end

to-report demora-terminal [orden-terminal]
  let punto-terminal one-of estaciones with [e-orden = orden-terminal]
  if punto-terminal = nobody [ report 0 ]
  report max (list 0 (ticks - [e-proxima-salida] of punto-terminal))
end

to-report ciclo-ideal
  if cfg-estaciones = 0 [ report 0 ]
  report 2 * ((cfg-estaciones - 1) * cfg-tramo + (cfg-estaciones - 2) * cfg-parada + cfg-maniobra)
end

to-report flota-orientativa
  if cfg-intervalo = 0 [ report 0 ]
  ; Redondeo a flota par por el reparto inicial entre terminales.
  report 2 * ceiling (ciclo-ideal / (2 * cfg-intervalo))
end

; ---------- VERIFICACIÓN AUTOMÁTICA ----------
to comprobar-modelo
  if balance != 0 [ error "No se conserva la cantidad de personas." ]
  if any? pasajeros with [p-personas &lt;= 0 or p-personas != floor p-personas] [
    error "Un grupo tiene una cantidad inválida."
  ]
  if any? pasajeros with [p-origen = p-destino or p-instante &gt; ticks] [
    error "Origen, destino o llegada inválidos."
  ]
  if any? pasajeros with [p-estado = "ESPERANDO" and p-tren != nobody] [
    error "Un grupo en espera tiene tren asignado."
  ]
  if any? pasajeros with [p-estado = "VIAJANDO" and p-tren = nobody] [
    error "Un grupo a bordo no tiene tren."
  ]
  if count trenes != cfg-trenes [ error "Se modificó la flota durante la ejecución." ]
  ask trenes [
    let tren-local self
    let estacion-local t-actual
    let destino-local t-objetivo
    let direccion-local t-sentido
    if sum [p-personas] of pasajeros with [p-tren = tren-local] &gt; t-capacidad [
      error "Un tren superó su capacidad."
    ]
    if member? t-estado ["LISTO" "MANIOBRA"] [
      if any? pasajeros with [p-tren = tren-local] [ error "Hay pasajeros en maniobra o depósito." ]
    ]
    if member? t-estado ["LISTO" "MANIOBRA"] [
      if not member? t-actual (list 0 (cfg-estaciones - 1)) [
        error "Una formación en depósito no está en una terminal."
      ]
      let x-terminal [xcor] of one-of estaciones with [e-orden = estacion-local]
      if abs (xcor - x-terminal) &gt; 0.000001 or not hidden? [
        error "Posición o visibilidad incorrecta en depósito terminal."
      ]
    ]
    if t-estado = "VIAJANDO" [
      let x-origen [xcor] of one-of estaciones with [e-orden = estacion-local]
      let x-destino [xcor] of one-of estaciones with [e-orden = destino-local]
      let x-esperada x-origen + (x-destino - x-origen) * (1 - t-restante / cfg-tramo)
      if abs (xcor - x-esperada) &gt; 0.000001 [
        error "El tren no sigue el tramo desde su estación de salida."
      ]
      if hidden? or ycor != ifelse-value (direccion-local = 1) [3] [-3] [
        error "Visibilidad o vía incorrecta durante el viaje."
      ]
      if t-restante &lt;= 0 [ error "Tiempo de viaje inválido." ]
      if any? other trenes with [t-estado = "VIAJANDO" and t-actual = estacion-local and t-sentido = direccion-local] [
        error "Dos trenes ocupan el mismo tramo y sentido."
      ]
      if any? other trenes with [t-estado = "DETENIDO" and t-actual = destino-local and t-sentido = direccion-local] [
        error "Un tren viaja hacia un andén ocupado."
      ]
    ]
    if t-estado = "DETENIDO" [
      if any? other trenes with [t-estado = "DETENIDO" and t-actual = estacion-local and t-sentido = direccion-local] [
        error "Dos trenes ocupan el mismo andén."
      ]
    ]
    if any? pasajeros with [p-tren = tren-local and p-sentido != direccion-local] [
      error "Pasajeros a bordo en sentido incorrecto."
    ]
  ]
end
</code>
  <widgets>
    <view x="320" y="65" width="913" height="265" minPxcor="-50" maxPxcor="50" minPycor="-14" maxPycor="14" patchSize="9" fontSize="12" frameRate="30" wrappingAllowedX="false" wrappingAllowedY="false" showTickCounter="true" tickCounterLabel="Segundos simulados" updateMode="1" />
    <note x="15" y="10" width="1220" height="40" fontSize="22" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">STR | Prototipo 3: dos vías, flota e intervalo entre salidas</note>
    <button x="15" y="65" width="150" height="40" display="Preparar / reiniciar" kind="Observer" forever="false" disableUntilTicks="false">setup</button>
    <button x="175" y="65" width="130" height="40" display="Un segundo" kind="Observer" forever="false" disableUntilTicks="true">go</button>
    <button x="15" y="115" width="150" height="40" display="Simular / pausar" kind="Observer" forever="true" disableUntilTicks="true">go</button>
    <button x="175" y="115" width="130" height="40" display="Avanzar 60 s" kind="Observer" forever="false" disableUntilTicks="true">repeat 60 [ go ]</button>
    <slider x="15" y="180" width="290" height="50" display="n-estaciones" variable="n-estaciones" min="3" max="10" step="1" default="5" direction="Horizontal" units="estaciones" />
    <slider x="15" y="238" width="290" height="50" display="n-trenes" variable="n-trenes" min="2" max="16" step="2" default="8" direction="Horizontal" units="formaciones" />
    <slider x="15" y="296" width="290" height="50" display="intervalo-seg" variable="intervalo-seg" min="10" max="240" step="10" default="60" direction="Horizontal" units="s" />
    <slider x="15" y="354" width="290" height="50" display="viaje-seg" variable="viaje-seg" min="5" max="120" step="5" default="30" direction="Horizontal" units="s" />
    <slider x="15" y="412" width="290" height="50" display="parada-seg" variable="parada-seg" min="1" max="60" step="1" default="10" direction="Horizontal" units="s" />
    <slider x="15" y="470" width="290" height="50" display="maniobra-seg" variable="maniobra-seg" min="1" max="120" step="1" default="20" direction="Horizontal" units="s" />
    <slider x="15" y="528" width="290" height="50" display="capacidad-tren" variable="capacidad-tren" min="1" max="300" step="1" default="60" direction="Horizontal" units="personas" />
    <slider x="15" y="586" width="290" height="50" display="demanda-min" variable="demanda-min" min="0" max="120" step="1" default="12" direction="Horizontal" units="pers/min/estación" />
    <slider x="15" y="644" width="290" height="50" display="semilla" variable="semilla" min="1" max="100" step="1" default="1" direction="Horizontal" units="" />
    <note x="15" y="710" width="290" height="130" fontSize="12" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">Aplicar cambios: Preparar.
Solo demanda-min cambia en marcha.

Violeta: hacia la última estación.
Rojo: hacia A.
Datos y tiempos de prueba.</note>
    <note x="320" y="335" width="913" height="45" fontSize="12" markdown="false" textColorLight="-16777216" textColorDark="-1" backgroundLight="0" backgroundDark="0">Arriba: A → última. Abajo: última → A. Naranja: viaje; azul: parada. Listos y maniobras: ocultos en terminal.
Cada punto representa hasta 5 personas. Se dibujan hasta 6 grupos por cola; los totales incluyen a todos.</note>
    <monitor x="320" y="390" width="215" height="60" display="Ingresados" precision="0" fontSize="12">ingresados</monitor>
    <monitor x="550" y="390" width="215" height="60" display="Esperando" precision="0" fontSize="12">esperando</monitor>
    <monitor x="780" y="390" width="215" height="60" display="A bordo" precision="0" fontSize="12">a-bordo</monitor>
    <monitor x="1010" y="390" width="215" height="60" display="Finalizados" precision="0" fontSize="12">finalizados</monitor>
    <monitor x="320" y="460" width="215" height="60" display="Espera al subir (s)" precision="1" fontSize="12">espera-media</monitor>
    <monitor x="550" y="460" width="215" height="60" display="Espera cola actual (s)" precision="1" fontSize="12">espera-en-cola</monitor>
    <monitor x="780" y="460" width="215" height="60" display="Balance = 0" precision="0" fontSize="12">balance</monitor>
    <monitor x="1010" y="460" width="215" height="60" display="En viaje / Listos / Maniobra" precision="0" fontSize="12">(word count trenes with [t-estado = "VIAJANDO"] " / " count trenes with [t-estado = "LISTO"] " / " count trenes with [t-estado = "MANIOBRA"])</monitor>
    <monitor x="320" y="530" width="215" height="60" display="Intervalo real A (s)" precision="1" fontSize="12">intervalo-real 0</monitor>
    <monitor x="550" y="530" width="215" height="60" display="Intervalo real última (s)" precision="1" fontSize="12">intervalo-real (cfg-estaciones - 1)</monitor>
    <monitor x="780" y="530" width="215" height="60" display="Demora A / última (s)" precision="0" fontSize="12">(word demora-terminal 0 " / " demora-terminal (cfg-estaciones - 1))</monitor>
    <monitor x="1010" y="530" width="215" height="60" display="Flota orientativa / actual" precision="0" fontSize="12">(word flota-orientativa " / " count trenes)</monitor>
    <plot x="320" y="615" width="448" height="220" display="Personas" xMin="0.0" xMax="300.0" yMin="0.0" yMax="20.0" autoPlotX="true" autoPlotY="true" legend="true" xAxis="Tiempo (s)" yAxis="Personas">
      <setup />
      <update />
      <pen display="Esperando" interval="1.0" mode="0" color="-8630108" legend="true">
        <setup />
        <update>plot esperando</update>
      </pen>
      <pen display="A bordo" interval="1.0" mode="0" color="-13345367" legend="true">
        <setup />
        <update>plot a-bordo</update>
      </pen>
    </plot>
    <plot x="785" y="615" width="448" height="220" display="Espera" xMin="0.0" xMax="300.0" yMin="0.0" yMax="20.0" autoPlotX="true" autoPlotY="true" legend="true" xAxis="Tiempo (s)" yAxis="Segundos">
      <setup />
      <update />
      <pen display="Al subir" interval="1.0" mode="0" color="-10899396" legend="true">
