to comprobar-geometria
  if cfg-estaciones != 16 or length rutas-ida != 15 or length rutas-vuelta != 15 [
    error "La geometría no contiene las dieciséis estaciones de la línea D."
  ]
  foreach (range 14) [ indice-local -&gt;
    let final-ida last (item indice-local rutas-ida)
    let inicio-ida first (item (indice-local + 1) rutas-ida)
    let final-vuelta last (item (indice-local + 1) rutas-vuelta)
    let inicio-vuelta first (item indice-local rutas-vuelta)
    if abs (item 0 final-ida - item 0 inicio-ida) &gt; 0.00001 or
       abs (item 1 final-ida - item 1 inicio-ida) &gt; 0.00001 or
       abs (item 0 final-vuelta - item 0 inicio-vuelta) &gt; 0.00001 or
       abs (item 1 final-vuelta - item 1 inicio-vuelta) &gt; 0.00001 [
      error "Hay una discontinuidad entre dos tramos."
    ]
  ]
end
